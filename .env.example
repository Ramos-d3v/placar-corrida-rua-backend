PORT=3001
FRONTEND_ORIGINS=http://localhost:5173
INGESTION_API_KEY=replace-with-a-long-random-secret
INGESTION_QUEUE_MAX_SIZE=10

# Use Neon pooled URL for application traffic and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require